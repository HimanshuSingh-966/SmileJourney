# FastAPI
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760

# Firebase Auth project ID used to validate ID tokens against Google's public signing certificates.
# This does not require Firebase Admin credentials or Google Cloud IAM credentials.
FIREBASE_PROJECT_ID=authentic-acumen-kcbh2

# Private Backblaze B2 S3-compatible bucket. App key needs bucket-scoped readFiles/writeFiles.
B2_ENDPOINT_URL=
B2_REGION=us-west-004
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Hugging Face model repository. Inference stays on Render; HF stores model artifacts.
HF_MODEL_REPO=
HF_TOKEN=
