# FastAPI
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760

# Firebase Admin. On Render, provide the service account JSON as an environment secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=authentic-acumen-kcbh2
FIRESTORE_DATABASE_ID=ai-studio-smilejourneyai-4261db67-ecc6-4635-a1d3-e7758d3ef046

# Backblaze B2 S3-compatible bucket for uploaded images.
B2_ENDPOINT_URL=
B2_REGION=us-west-004
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PUBLIC_BASE_URL=

# Hugging Face model repository. Inference stays on Render; HF stores model artifacts.
HF_MODEL_REPO=
HF_TOKEN=
